{
  "AppSettings": {
    "OpeningTime": "00:00",
    "ClosingTime": "20:00:00",
    "MaxSpots": 4,
    "MinimumAppointmentDurationInMinutes": 30,
    "LocalCacheExpirationInMins": 5,
    "DistributedCacheExpirationMins": 5,
    "DefaultPageNumber": 1,
    "DefaultPageSize": 10,
    "BookingCancellationThresholdMinutes": 15,
    "OverdueBookingCleanupFrequencyMinutes": 3,
    "CorsPolicyName": "MechanicShop",
    "DefaultCurrency": "egp",
    "AllowedOrigins": [ "http://localhost:7001", "http://mechanicshop-app" ],
    "ClientAppBaseUrl": "http://localhost:7001"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=...;Database=MechanicShopDb;...",
    "RedisConnection": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://ops.seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "api"
    }
  },
  "JwtSettings": {
    "Secret": "",
    "TokenExpirationInMinutes": 60,
    "Issuer": "MechanicShopApi",
    "Audience": "MechanicShopClients"
  },
  "EmailSettings": {
    "SmtpServer": "sandbox.smtp.mailtrap.io",
    "Port": 587,
    "SenderName": "Mechanic Shop Team",
    "SenderEmail": "info@mechanicshop.com",
    "AdminEmail": "f18408aa9@gmail.com",
    "Username": "",
    "Password": ""
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": ""
  }
}