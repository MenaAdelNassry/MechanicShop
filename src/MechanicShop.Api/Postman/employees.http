@baseUrl = http://localhost:5001
@apiVersion = 1.0
@contentType = application/json

@authToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Lhg8lRfh6mDc6fJiF45oQDH4bkbdlan-TigBIAU9DaE

### 2. Create Employee (Requires ManagerOnly Permission)
# @name createEmployee
POST {{baseUrl}}/api/v{{apiVersion}}/employees
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "firstName": "Maged",
  "lastName": "Adel",
  "email": "maged.adel@mechanicshop.com",
  "phoneNumber": "01021245678",
  "role": "Labor"
}

### 3. Get All Employees
GET {{baseUrl}}/api/v{{apiVersion}}/employees
Authorization: Bearer {{authToken}}

### 4. Filter Employees by Role
GET {{baseUrl}}/api/v{{apiVersion}}/employees?role=Labor
Authorization: Bearer {{authToken}}

### 5. Get Employee By ID
@employeeId = 01a0a0ee-cfa6-7104-ae69-63c3b23f4b38
GET {{baseUrl}}/api/v{{apiVersion}}/employees/{{employeeId}}
Authorization: Bearer {{authToken}}

### 6. Resend Employee Setup Email
POST {{baseUrl}}/identity/resend-setup-email
Content-Type: {{contentType}}

{
  "email": "maged.adel@mechanicshop.com"
}